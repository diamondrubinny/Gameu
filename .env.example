# Copy to .env (never commit real values). All variables are optional.

# HTTP/WebSocket port the console listens on.
PORT=8080

# Interface to bind. 0.0.0.0 = reachable from phones on the LAN.
BIND_ADDRESS=0.0.0.0

# Optional. Enables "mode C": opening the TV screen from a remote browser
# (e.g. a smart-TV browser) via http://<ip>:<port>/?key=<value>.
# Leave empty to allow the TV screen only from this computer (localhost).
# Use a long random value, e.g. `openssl rand -hex 16`.
GAMEU_HOST_KEY=

# Where settings are stored (defaults to ./data next to the app).
GAMEU_DATA_DIR=

# debug | info | warn | error
LOG_LEVEL=info
